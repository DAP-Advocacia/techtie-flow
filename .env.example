# Porta onde o gateway HTTP/WebSocket vai rodar
PORT=3333

# Pasta onde as sessões do Baileys (credenciais do WhatsApp) são salvas.
# IMPORTANTE: persista essa pasta em volume persistente (não em container
# efêmero), senão a sessão se perde e o QR Code precisa ser escaneado de
# novo a cada deploy. Em multi-tenant, cada sessão fica em
# <AUTH_FOLDER>/<tenantId>_<instanceId>/ (ver src/sessions.js).
AUTH_FOLDER=./auth_session

# Máximo de pareamentos (handshakes de QR Code novo) rodando ao mesmo tempo.
# Existe porque picos de conexão simultânea (ex: vários clientes/usuários
# conectando ao mesmo tempo) derrubam parte das tentativas — ver
# docs/whatsapp-gateway-licoes-herdadas.md, seção 2. Padrão: 4.
MAX_CONCURRENT_PAIRINGS=4

# Teto de tentativas de reconexão CONSECUTIVAS para um código de desconexão
# "temporário" (não permanente — ver docs/whatsapp-gateway-licoes-herdadas.md,
# seção 3), antes de marcar a sessão como "precisa de atenção manual" e
# parar de insistir sozinho. Padrão: 20.
MAX_RECONNECT_ATTEMPTS=20

# Supabase — banco (Postgres) e storage de mídia (imagem/áudio/vídeo).
# Painel do projeto: Settings > API (URL + secret key) e Settings > Database
# (connection string, botão "Connect" no topo do dashboard).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU-SECRET-KEY

# Pooler de transação (pgbouncer) — usado pela aplicação em runtime.
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@SEU-HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler de sessão — usado só para rodar migração de schema.
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@SEU-HOST.pooler.supabase.com:5432/postgres"
# Máximo de conexões simultâneas do processo com o pooler acima (ver
# src/db.js) — opcional, default 10 se não definida.
# DB_POOL_MAX=10

# --- Operação (API + WebSocket + WhatsApp) -----------------------------------
# A API só liga quando DATABASE_URL e AUTH_TOKEN_SECRET existem; sem eles o servidor serve
# apenas o protótipo com dados fictícios. Passo a passo: docs/piloto.md.
#
# Segredo que assina os tokens de login (32+ caracteres). Gere com:
#   node -p "require('crypto').randomBytes(48).toString('base64url')"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=12
# Senha do papel `app_user` (o que a aplicação usa em DATABASE_URL). A migração só cria o papel;
# defina a senha rodando `node db/migrate.mjs` com APP_USER_PASSWORD no ambiente.
# APP_USER_PASSWORD=
# Origens do front autorizadas a chamar a API (separadas por vírgula). Só necessário quando o
# front roda em OUTRO domínio (ex.: o site da Vercel). Mesma origem: deixe vazio.
# CORS_ORIGIN=https://techtie-flow.vercel.app
# URL pública do front: entra no link de convite de usuários.
# APP_URL=https://techtie-flow.vercel.app
# Atrás de proxy reverso (EasyPanel/Nginx/Cloudflare)? Ligue para ler o IP real do cliente
# (limite de tentativas de login e auditoria por IP). Sem proxy, deixe desligado.
# TRUST_PROXY=true
# Desliga só o canal de WhatsApp (API e login continuam): WHATSAPP_ENABLED=false
# Onde guardar mídia recebida quando NÃO há Supabase Storage (padrão ./media_store).
# MEDIA_FOLDER=./media_store
# Só para o script db/seed.mjs (cria o 1º tenant e o admin). A senha vem do ambiente, nunca de argumento.
# SEED_TENANT_NAME=
# SEED_TENANT_SLUG=
# SEED_ADMIN_NAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# --- WhatsApp Cloud API oficial (Meta) — CloudApiChannel, ainda não implementado ---
# Credenciais de app Tech Provider/Solution Partner + Embedded Signup.
# Preencher quando o backend do canal oficial for implementado ao lado do
# BaileysChannel (ver README.md, decisões de produto).
# META_APP_ID=
# META_APP_SECRET=
# META_SYSTEM_USER_TOKEN=

# --- Agente de IA (OpenAI) --------------------------------------------------------------------------
# A chave fica SÓ no servidor (no Coolify: Environment Variables, marcada como secret). O navegador nunca a vê.
# Sem ela o resto do sistema funciona e o agente simplesmente não responde.
OPENAI_API_KEY=
# Modelo de chat. Padrão: gpt-4o-mini (barato e rápido). Use modelos que aceitem temperature/max_tokens
# (família gpt-4o / gpt-4.1); os "gpt-5*" e "o*" são de raciocínio e exigem outros parâmetros.
# OPENAI_MODEL=gpt-4o-mini
# Teto de tokens por dia e por empresa (controle de custo). A IA para de responder ao atingir; padrão 300000.
# AI_DAILY_TOKEN_CAP=300000
